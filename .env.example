# DOTA2 Watcher 插件配置示例
# 复制本文件为 .env 并按需修改，所有配置项均以 D2W_ 为前缀。
# 未设置的项将使用 config.py 中的默认值，请勿直接修改插件包内的 config.py。

# Steam Web API Key（https://steamcommunity.com/dev/apikey 申请）
# 用于拉取玩家比赛历史；留空时比赛播报不可用，其余功能正常
D2W_STEAM_API_KEY=

# TI 赛事 / 实时单局使用的独立 API Key，留空时复用上面的 D2W_STEAM_API_KEY
D2W_TI_STEAM_API_KEY=

# 网络代理，如 {"http": "http://127.0.0.1:7890", "https": "http://127.0.0.1:7890"}
D2W_PROXIES={}

# GitHub 加速前缀（国内访问 GitHub raw 资源时使用，可替换为其它代理）
D2W_GH_PROXY=https://gh-proxy.com

# 运行期数据根目录（订阅数据 / 缓存 / 图片 / 战报输出），留空时使用当前工作目录
D2W_DATA_DIR=

# 网络请求超时（秒）
D2W_TIMEOUT=20

# “全体”播报的昵称关键字
D2W_ALL_NICKNAME=全体

# 不播报的游戏模式列表
D2W_GAME_MODE=[15, 19]

# 评分标准（0~1），仅 OpenDota 支持
D2W_BENCHMARK_THRESHOLD=0.5

# 定时任务轮询间隔（秒）
D2W_TI_POLL_INTERVAL=10
D2W_NEWS_POLL_INTERVAL=60
D2W_MATCH_POLL_INTERVAL=60

# 数据缓存时长（秒）
D2W_CACHE_EXPIRE_SECONDS=3600
D2W_CORE_BUILD_CACHE_SECONDS=86400

# 网络 / 下载 / 分析超时（秒）
D2W_DOWNLOAD_TIMEOUT=60
D2W_MATCH_ANALYSIS_TIMEOUT=120